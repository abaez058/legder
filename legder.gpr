library project Legder is
   for Library_Name use "legder";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnatyM100", "-g", "-O1", "-fstack-check");
   end Compiler;
   package Prove is
      --  Bound the provers by steps, not seconds, so a proof gives the
      --  same answer on a fast Mac and a slow Windows CI runner.
      for Proof_Switches ("Ada") use
        ("--level=1", "--timeout=0", "--steps=2000", "-j0");
   end Prove;
end Legder;
